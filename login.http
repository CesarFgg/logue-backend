### 1. Login exitoso - Niño (Mateo)
POST http://localhost:8080/login
Content-Type: application/json

{
  "usuario": "nino",
  "password": "1234"
}
# Resultado esperado: HTTP 200 OK
# {"exito":true,"mensaje":"Bienvenido","usuario":{"id":1,"nombre":"Mateo","rol":"NINO"}}

